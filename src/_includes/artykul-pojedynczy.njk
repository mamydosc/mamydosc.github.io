---
layout: base.njk
nav: start
---
<div class="phead"><div class="wrap baner">
  <div class="baner-tresc">
  <h1>{{ title }}</h1>
  <div class="byline"><span>{{ numer }}</span><span>{{ page.date | dataDzien }}</span><span>{{ content | czasCzytania }} min czytania</span><span>Fundacja MAMY DOŚĆ</span></div>
  </div>
  {% include "ciekawostki-baner.njk" %}
</div></div>
<div class="wrap article">
  <article class="prose">
    {%- set nad = collections.artykuly | znajdzNr(nadrzedny) if nadrzedny else false -%}
    {% if nad %}<p class="watek">Wątek tematu <a href="{{ nad.url }}">{{ nad.data.numer }} · {{ nad.data.title }}</a></p>{% endif %}
    <p class="lead">{{ lead }}</p>
    {{ content | safe }}
    {%- set dzieci = collections.artykuly | watki(numer) -%}
    {% if dzieci.length %}<div class="watki"><b>Wątki w tym temacie</b><ol>{% for t in dzieci %}<li><a href="{{ t.url }}">{{ t.data.numer }} · {{ t.data.title }}</a></li>{% endfor %}</ol></div>{% endif %}
    {% if zrodla %}<div class="sources"><b>Źródła</b><ul>{% for z in zrodla %}<li>{{ z }}</li>{% endfor %}</ul></div>{% endif %}
    <div class="btns"><a class="btn line" href="/">← Nasze publikacje</a><a class="btn red" href="/zglos/">Masz podobną sprawę? Zgłoś</a></div>
  </article>
</div>
