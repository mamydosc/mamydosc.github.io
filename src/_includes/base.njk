<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% if title and title != site.nazwa %}{{ title }} · {% endif %}MAMY DOŚĆ</title>
<meta name="description" content="{{ opisStrony or site.opis }}">
{% if site.robocza %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.nazwa }}">
<meta property="og:description" content="{{ opisStrony or site.opis }}">
<meta property="og:type" content="{% if layout == 'artykul.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if obraz %}<meta property="og:image" content="{{ site.url }}{{ obraz }}">{% endif %}
<meta property="og:locale" content="pl_PL">
<link rel="icon" href="/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/WixMadeforDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/WixMadeforText-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css">
<link rel="stylesheet" href="/assets/nowy.css">
</head>
<body>
<a class="skip" href="#tresc">Przejdź do treści</a>

<header class="top on-navy">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Fundacja MAMY DOŚĆ – strona główna"><img src="/assets/img/logo-granat.svg" alt="Fundacja MAMY DOŚĆ – bezkarności urzędników" width="184" height="81"></a>
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav">MENU</button>
    <nav class="nav" id="nav" aria-label="Menu główne">
      <a href="/sledztwa/"{% if nav == 'sledztwa' %} aria-current="page"{% endif %}>Śledztwa</a>
      <a href="/publikacje/"{% if nav == 'publikacje' %} aria-current="page"{% endif %}>Publikacje</a>
      <a href="/akta/"{% if nav == 'akta' %} aria-current="page"{% endif %}>Akta spraw</a>
      <a href="/ludzie-wladzy/"{% if nav == 'ludzie' %} aria-current="page"{% endif %}>Ludzie władzy</a>
      <a href="/o-fundacji/"{% if nav == 'fundacja' or nav == 'finanse' %} aria-current="page"{% endif %}>O fundacji</a>
      <a href="/wesprzyj/" class="ghostcta"{% if nav == 'wesprzyj' %} aria-current="page"{% endif %}>Wesprzyj</a>
      <a href="/zglos/" class="cta"{% if nav == 'zglos' %} aria-current="page"{% endif %}>Zgłoś</a>
    </nav>
  </div>
</header>
<main id="tresc">
{{ content | safe }}
</main>
<footer class="foot">
  <div class="wrap">
    <div><b>Fundacja MAMY DOŚĆ</b><p style="margin: 8px 0 0;">{{ site.adres }}<br>KRS {{ site.krs }} · NIP {{ site.nip }}{% if site.regon %} · REGON {{ site.regon }}{% endif %}</p></div>
    <div><b>Strona</b><ul><li><a href="/sledztwa/">Śledztwa</a></li><li><a href="/publikacje/">Publikacje</a></li><li><a href="/akta/">Akta spraw</a></li><li><a href="/ludzie-wladzy/">Ludzie władzy</a></li><li><a href="/zglos/">Zgłoś nieprawidłowość</a></li><li><a href="/wesprzyj/">Wesprzyj</a></li></ul></div>
    <div><b>Kontakt</b><ul><li>{{ site.email }}</li><li>e-Doręczenia: {{ site.eDoreczenia }}</li><li>ePUAP: {{ site.epuap }}</li><li><a href="/o-fundacji/">O fundacji</a></li><li><a href="/finanse/">Finanse</a></li><li><a href="/archiwum/">Archiwum dokumentów</a></li><li><a href="/kontakt/">Kontakt</a></li><li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li></ul></div>
    <div class="legal">Strona bez plików cookies i bez śledzenia. Nasze oceny oznaczamy jako nasze. To nie jest porada prawna.
      <div class="theme" role="group" aria-label="Motyw strony">
        <button type="button" data-t="" aria-pressed="true">Auto</button>
        <button type="button" data-t="light" aria-pressed="false">Jasny</button>
        <button type="button" data-t="dark" aria-pressed="false">Ciemny</button>
      </div>
    </div>
  </div>
</footer>
<script src="/assets/main.js" defer></script>
<script src="/assets/nowy.js" defer></script>
</body>
</html>
