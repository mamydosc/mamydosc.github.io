<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<script>try{var t=sessionStorage.getItem("tryb");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);if(sessionStorage.getItem("panel")==="zw")document.documentElement.setAttribute("data-panel","zw");var w=sessionStorage.getItem("widok");if(w==="male"||w==="duze")document.documentElement.setAttribute("data-widok",w)}catch(e){}</script>
<title>{% if title and title != site.nazwa %}{{ title }} · {% endif %}MAMY DOŚĆ</title>
<meta name="description" content="{{ opisStrony or site.opis }}">
{% if site.robocza %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.nazwa }}">
<meta property="og:description" content="{{ opisStrony or site.opis }}">
<meta property="og:type" content="{% if layout == 'artykul.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if obraz %}<meta property="og:image" content="{{ site.url }}{{ obraz }}">{% endif %}
<meta property="og:locale" content="pl_PL">
<link rel="icon" href="/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/WixMadeforDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/WixMadeforText-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css?v={{ wersja }}">
<link rel="stylesheet" href="/assets/nowy.css?v={{ wersja }}">
</head>
<body>
<a class="skip" href="#tresc">Przejdź do treści</a>

<header class="top on-navy">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Fundacja MAMY DOŚĆ – strona główna"><img src="/assets/img/logo/logo-2-granat-czerwone-bez-tla.svg" alt="Fundacja MAMY DOŚĆ – miernoty i bezkarności urzędników" width="170" height="110"></a>
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav">MENU</button>
    <nav class="nav" id="nav" aria-label="Menu główne">
      {% if nav == 'artykul' and numer %}<span class="nav-w"><a href="/" aria-current="true">Nasze publikacje</a><span class="nav-syg" title="Artykuł {{ numer }}">{{ numer }}</span></span>{% else %}<a href="/"{% if nav == 'start' %} aria-current="page"{% endif %}>Nasze publikacje</a>{% endif %}
      <a href="/baza-danych/"{% if nav == 'baza' %} aria-current="page"{% endif %}>Baza danych</a>
      <a href="/poradnik/"{% if nav == 'poradnik' %} aria-current="page"{% endif %}>Poradnik</a>
      <a href="/o-fundacji/"{% if nav == 'fundacja' %} aria-current="page"{% endif %}>O fundacji</a>
      <a href="/wesprzyj/"{% if nav == 'wesprzyj' %} aria-current="page"{% endif %}>Wesprzyj</a>
      <a href="/zglos/" class="cta"{% if nav == 'zglos' %} aria-current="page"{% endif %}>Zgłoś</a>
    </nav>
    <div class="theme" role="group" aria-label="Tryb strony">
      <button type="button" data-t="light" aria-pressed="false">Jasny</button>
      <button type="button" data-t="dark" aria-pressed="false">Ciemny</button>
    </div>
  </div>
</header>
<main id="tresc">
{{ content | safe }}
</main>
<div class="viewer" id="podglad" role="dialog" aria-modal="true" aria-labelledby="podglad-t" hidden>
  <div class="vin" id="podglad-in">
    <div class="vhead"><span id="podglad-t">Podgląd dokumentu</span><span class="vbtns"><button type="button" class="vclose" id="podglad-obok" hidden>Połóż obok</button><button type="button" class="vclose" id="podglad-jeden" hidden>Tylko jeden</button><a class="vclose" id="podglad-pobierz" href="#" download hidden>Pobierz</a><button type="button" class="vclose" id="podglad-zamknij">Zamknij</button></span></div>
    <div class="docpair one" id="podglad-dok"></div>
  </div>
</div>
<footer class="foot">
  <div class="wrap">
    <div><img class="foot-logo2" src="/assets/img/logo/logo-6-granat-biale-bez-tla.svg" alt="Fundacja MAMY DOŚĆ – miernoty i bezkarności urzędników" width="220" height="142" loading="lazy"><p style="margin: 12px 0 0;">{{ site.adres }}<br>KRS {{ site.krs }} · NIP {{ site.nip }}{% if site.regon %} · REGON {{ site.regon }}{% endif %}</p></div>
    <div><b>Strona</b><ul><li><a href="/">Nasze publikacje</a></li><li><a href="/lista-wstydu/">Lista… wstydu?</a></li><li><a href="/baza-danych/">Baza danych</a></li><li><a href="/poradnik/">Poradnik</a></li><li><a href="/zglos/">Zgłoś nieprawidłowość</a></li><li><a href="/wesprzyj/">Wesprzyj</a></li></ul></div>
    <div><b>Fundacja</b><ul><li>Oficjalnie: {{ site.email }}</li><li>Anonimowo: {{ site.emailAnonimowy }}</li><li>e-Doręczenia: {{ site.eDoreczenia }}</li><li>ePUAP: {{ site.epuap }}</li><li><a href="/o-fundacji/">O fundacji</a></li><li><a href="/o-fundacji/#finanse">Finanse</a></li><li><a href="/o-fundacji/#kontakt">Kontakt</a></li><li><a href="/baza-danych/#archiwum">Archiwum dokumentów</a></li><li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li></ul></div>
    <div class="legal">
      <p class="nieprawnicy">Nie jesteśmy prawnikami – nikt z nas nie jest adwokatem ani radcą prawnym. Nie świadczymy pomocy prawnej, w tym porad prawnych, w rozumieniu art. 4 ust. 1 ustawy – Prawo o adwokaturze i art. 6 ust. 1 ustawy o radcach prawnych. Treści na stronie mają charakter informacyjny i publicystyczny. W swojej sprawie skontaktuj się z adwokatem lub radcą prawnym.</p>
      <p>Strona bez plików cookies, analityki i reklam. Nasze oceny oznaczamy jako nasze.</p>
    </div>
  </div>
</footer>
<script id="dane-dokumenty" type="application/json">{{ dokumenty | dump | safe }}</script>
<script src="/assets/main.js?v={{ wersja }}" defer></script>
<script src="/assets/nowy.js?v={{ wersja }}" defer></script>
</body>
</html>
