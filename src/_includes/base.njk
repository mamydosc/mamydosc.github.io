<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% if title and title != site.nazwa %}{{ title }} · {% endif %}MAMY DOŚĆ</title>
<meta name="description" content="{{ opisStrony or site.opis }}">
{% if site.robocza %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.nazwa }}">
<meta property="og:description" content="{{ opisStrony or site.opis }}">
<meta property="og:type" content="{% if layout == 'artykul.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if obraz %}<meta property="og:image" content="{{ site.url }}{{ obraz }}">{% endif %}
<meta property="og:locale" content="pl_PL">
<link rel="icon" href="/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/WixMadeforDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/WixMadeforText-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<a class="skip" href="#tresc">Przejdź do treści</a>
{% if site.robocza %}<div class="preview"><div class="wrap"><span>WERSJA ROBOCZA · nowa mamydosc.org · treści i dane do sprawdzenia</span><span>stan treści: {{ site.stanTresci | data }}</span></div></div>{% endif %}
<header class="top">
  <div class="wrap">
    <a class="logo" href="/"><i></i>MAMY DOŚĆ</a>
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav">MENU</button>
    <nav class="nav" id="nav" aria-label="Menu główne">
      <a href="/akta/"{% if nav == 'akta' %} aria-current="page"{% endif %}>Akta spraw</a>
      <a href="/publikacje/"{% if nav == 'publikacje' %} aria-current="page"{% endif %}>Publikacje</a>
      <a href="/o-fundacji/"{% if nav == 'fundacja' %} aria-current="page"{% endif %}>O fundacji</a>
      <a href="/kontakt/"{% if nav == 'kontakt' %} aria-current="page"{% endif %}>Kontakt</a>
      <a href="/przekaz-dokumenty/" class="cta"{% if nav == 'przekaz' %} aria-current="page"{% endif %}>Przekaż dokumenty</a>
    </nav>
  </div>
</header>
<main id="tresc">
{{ content | safe }}
</main>
<footer class="foot">
  <div class="wrap">
    <div><b>Fundacja MAMY DOŚĆ</b><p style="margin:8px 0 0">Ujawniamy nieprawidłowości w urzędach i sądach. Na dokumentach.</p><p class="mono" style="margin:12px 0 0">{% if site.krs %}KRS {{ site.krs }}{% else %}KRS – do uzupełnienia{% endif %} · {% if site.nip %}NIP {{ site.nip }}{% else %}NIP – do uzupełnienia{% endif %}</p></div>
    <div><b>Strona</b><ul><li><a href="/akta/">Akta spraw</a></li><li><a href="/publikacje/">Publikacje</a></li><li><a href="/przekaz-dokumenty/">Przekaż dokumenty</a></li></ul></div>
    <div><b>Fundacja</b><ul><li><a href="/o-fundacji/">O fundacji</a></li><li><a href="/kontakt/">Kontakt</a></li><li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li></ul></div>
    <div class="legal">Strona bez plików cookies i bez śledzenia. Nasze oceny oznaczamy jako nasze. To nie jest porada prawna.</div>
  </div>
</footer>
<script src="/assets/main.js" defer></script>
</body>
</html>
