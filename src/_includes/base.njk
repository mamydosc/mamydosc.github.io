<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% if title and title != site.nazwa %}{{ title }} · {% endif %}MAMY DOŚĆ</title>
<meta name="description" content="{{ opisStrony or site.opis }}">
{% if site.robocza %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.nazwa }}">
<meta property="og:description" content="{{ opisStrony or site.opis }}">
<meta property="og:type" content="{% if layout == 'artykul.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if obraz %}<meta property="og:image" content="{{ site.url }}{{ obraz }}">{% endif %}
<meta property="og:locale" content="pl_PL">
<link rel="icon" href="/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/WixMadeforDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/WixMadeforText-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css">
<link rel="stylesheet" href="/assets/nowy.css">
</head>
<body>
<a class="skip" href="#tresc">Przejdź do treści</a>

<header class="top on-navy">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Fundacja MAMY DOŚĆ – strona główna"><img src="/assets/img/logo/logo-2-granat-czerwone.svg" alt="Fundacja MAMY DOŚĆ – miernoty i bezkarności urzędników" width="170" height="110"></a>
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav">MENU</button>
    <nav class="nav" id="nav" aria-label="Menu główne">
      <a href="/"{% if nav == 'start' %} aria-current="page"{% endif %}>Nasze publikacje</a>
      <a href="/baza-danych/"{% if nav == 'baza' %} aria-current="page"{% endif %}>Baza danych</a>
      <a href="/poradnik/"{% if nav == 'poradnik' %} aria-current="page"{% endif %}>Poradnik</a>
      <a href="/o-fundacji/"{% if nav == 'fundacja' %} aria-current="page"{% endif %}>O fundacji</a>
      <a href="/wesprzyj/" class="ghostcta"{% if nav == 'wesprzyj' %} aria-current="page"{% endif %}>Wesprzyj</a>
      <a href="/zglos/" class="cta"{% if nav == 'zglos' %} aria-current="page"{% endif %}>Zgłoś</a>
    </nav>
  </div>
</header>
{%- set LW = lobuziaki.wpisy | najnowszeNaGorze("data") -%}
{% if LW.length %}
<div class="lobuz" role="region" aria-label="Lista łobuziaków">
  <div class="wrap">
    <a class="lobuz-h" href="/lista-lobuziakow/">Lista<b>łobuziaków</b></a>
    <div class="lobuz-row">
      {% for w in LW %}<a class="lobuz-chip" href="/lista-lobuziakow/#{{ w.id }}"><b>{{ w.imie }}</b><span>{{ w.krotko }}</span></a>{% endfor %}
    </div>
    <a class="lobuz-all" href="/lista-lobuziakow/">Wszyscy →</a>
  </div>
</div>
{% endif %}
<main id="tresc">
{{ content | safe }}
</main>
<footer class="foot">
  <div class="wrap">
    <div><img class="foot-logo2" src="/assets/img/logo/logo-6-granat-biale.svg" alt="Fundacja MAMY DOŚĆ – miernoty i bezkarności urzędników" width="220" height="142" loading="lazy"><p style="margin: 12px 0 0;">{{ site.adres }}<br>KRS {{ site.krs }} · NIP {{ site.nip }}{% if site.regon %} · REGON {{ site.regon }}{% endif %}</p></div>
    <div><b>Strona</b><ul><li><a href="/">Nasze publikacje</a></li><li><a href="/lista-lobuziakow/">Lista łobuziaków</a></li><li><a href="/baza-danych/">Baza danych</a></li><li><a href="/poradnik/">Poradnik</a></li><li><a href="/zglos/">Zgłoś nieprawidłowość</a></li><li><a href="/wesprzyj/">Wesprzyj</a></li></ul></div>
    <div><b>Fundacja</b><ul><li>{{ site.email }}</li><li>e-Doręczenia: {{ site.eDoreczenia }}</li><li>ePUAP: {{ site.epuap }}</li><li><a href="/o-fundacji/">O fundacji</a></li><li><a href="/o-fundacji/#finanse">Finanse</a></li><li><a href="/o-fundacji/#kontakt">Kontakt</a></li><li><a href="/archiwum/">Archiwum dokumentów</a></li><li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li></ul></div>
    <div class="legal">Strona bez plików cookies i bez śledzenia. Nasze oceny oznaczamy jako nasze. To nie jest porada prawna.
      <div class="theme" role="group" aria-label="Motyw strony">
        <button type="button" data-t="" aria-pressed="true">Auto</button>
        <button type="button" data-t="light" aria-pressed="false">Jasny</button>
        <button type="button" data-t="dark" aria-pressed="false">Ciemny</button>
      </div>
    </div>
  </div>
</footer>
<script src="/assets/main.js" defer></script>
<script src="/assets/nowy.js" defer></script>
</body>
</html>
